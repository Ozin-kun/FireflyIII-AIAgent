# ── Firefly III Configuration ────────────────────────────────
# Gunakan http://localhost:8085 jika menjalankan via docker compose di root folder
# Gunakan http://localhost:8080 jika menggunakan mock_firefly.py
FIREFLY_BASE_URL=http://localhost:8085
FIREFLY_API_TOKEN=your_firefly_personal_access_token_here

# ── Google Gemini LLM ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Model rekomendasi: gemini-2.5-flash (seimbang & cepat) atau gemini-3.5-flash-lite / gemini-2.0-flash
LLM_MODEL=gemini-2.5-flash
