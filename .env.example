# ── Firefly III Environment Template ───────────────────────────
# Salin file ini menjadi .env sebelum menjalankan: docker compose up -d

APP_ENV=production
APP_DEBUG=false
SITE_OWNER=mail@example.com

# Key enkripsi sesi (Wajib string 32 karakter unik tanpa spasi)
# Contoh generate di bash: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
APP_KEY=ChangeThisTo32CharactersStringNow

DEFAULT_LANGUAGE=id_ID
DEFAULT_LOCALE=id_ID
TZ=Asia/Jakarta

# Koneksi Database MariaDB (Sesuai container db di docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=secret_firefly_password

# Static cron token untuk cron container (Wajib tepat 32 karakter)
STATIC_CRON_TOKEN=ChangeThisTo32CharactersCronNow1
